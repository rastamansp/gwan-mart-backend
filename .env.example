# Configurações básicas
NODE_ENV=development
PORT=3011

# API Base URL para QR Codes
API_BASE_URL=http://localhost:3011

# JWT Secret (em produção, use uma chave segura)
JWT_SECRET=your-secret-key-change-in-production

# MCP Server
MCP_BASE_URL=http://localhost:3011
MCP_PORT_SSE=3002
MCP_AUTH_TOKEN=your-auth-token

# CORS para frontend
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Conexão com o banco de dados
DATABASE_URL=postgresql://postgres:password@localhost:5432/gwan_imoveis

# OpenAI (para embeddings e chatbot)
OPENAI_API_KEY=sk-proj-your-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# Evolution API (WhatsApp)
EVOLUTION_API_KEY=your-evolution-api-key
EVOLUTION_INSTANCE=your-evolution-instance
EVOLUTION_INSTANCE_URL=http://localhost:8080
EVOLUTION_INSTANCE_NAME=Gwan

# Redis Cache
REDIS_URL=redis://localhost:6379

# MinIO (Storage de Imagens)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=gwan-mart-uploads
MINIO_USE_SSL=false
# ========================================
# FRONTEND (links de produto nas respostas do chat)
# ========================================
# Base da loja do Mart (diretorio web/ deste repo).
# Dev: http://localhost:5184 | Producao: https://mart.gwan.cloud
FRONTEND_URL=https://mart.gwan.cloud
# Rota de produto na loja: /product/:code
FRONTEND_PRODUCT_PATH=product

# ========================================
# LIMITE DA BUSCA SEMANTICA (products/search/similar)
# ========================================
# Rota publica (a pagina de catalogo chama sem token) e cada chamada gera
# embedding pago. Teto por IP: SEMANTIC_SEARCH_LIMIT chamadas por janela.
SEMANTIC_SEARCH_LIMIT=10
SEMANTIC_SEARCH_TTL_MS=60000

# ========================================
# HEALTH CHECK
# ========================================
# Teto por dependencia verificada (PostgreSQL, MinIO, Redis).
HEALTH_CHECK_TIMEOUT_MS=2000
